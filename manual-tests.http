### -- MODE TOGGLE — demo / light / full (see src/ingestion/context.ts) ----------

### demo (default) — all cached/synthetic, postcode-live only. Stage-safe (~<1s).
GET {{base}}/api/nhs/context?postcode=M13%209PL

### light — postcode + Fingertips population + RTT-by-ICB waiting times live.
### First call is ~7-12s (Fingertips bulk fetch); subsequent calls are <100ms (24h memo).
GET {{base}}/api/nhs/context?postcode=M13%209PL&mode=light

### light for a non-Manchester postcode — Fingertips returns Westminster indicators,
### RTT returns the per-ICB % for NHS North West London ICB.
GET {{base}}/api/nhs/context?postcode=SW1A%201AA&mode=light

### full — also tries NHS Service Search live. Without NHS_API_KEY in .env, services
### degrade to dataQuality="cached-fallback".
GET {{base}}/api/nhs/context?postcode=M13%209PL&mode=full

### invalid postcode in light mode — every adapter degrades honestly.
GET {{base}}/api/nhs/context?postcode=ZZ99%209ZZ&mode=light

### -- AGGREGATE /api/nhs/full — one round-trip for the UI -----------------------

### light mode aggregate. Returns { mode, context, profile } so the UI does one
### fetch instead of orchestrating /api/nhs/context + /api/nhs/profile.
POST {{base}}/api/nhs/full?mode=light
content-type: application/json

{
  "patient": {
    "age": 52,
    "livesInEngland": true,
    "hasCvd": false,
    "hasChronicKidneyDisease": false,
    "hasDiabetes": false,
    "hasHypertension": false,
    "hasAtrialFibrillation": false,
    "hasStrokeOrTia": false,
    "hasFamilialHypercholesterolaemia": false,
    "hasHeartFailure": false,
    "hasPeripheralArterialDisease": false,
    "onStatins": false,
    "previousHighCvdRisk": false,
    "bpCheckedLast6Months": true,
    "systolicBp": 122,
    "diastolicBp": 78,
    "totalCholesterol": 4.8,
    "hdlCholesterol": 1.2,
    "bmi": 26,
    "waistCircumferenceCm": 92,
    "smokingStatus": "former",
    "chestPain": false,
    "strokeSymptoms": false,
    "severeBreathlessness": false
  },
  "postcode": "M13 9PL"
}

