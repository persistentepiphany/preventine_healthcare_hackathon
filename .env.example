# z.ai / GLM-5.1 credentials
ZAI_API_KEY=your-api-key-here
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-5.1

# Cap on completion tokens. GLM-5.1 is a reasoning model — it spends most of its
# completion budget on hidden `reasoning_content` before emitting `content`. Set
# this generously (≥ 2000) or the model returns an empty `content` string.
ZAI_MAX_TOKENS=4000
